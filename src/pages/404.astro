---
import Base from '../layouts/Base.astro';
---

<Base
  title="Packet lost! | Guess the Speed"
  description="This page never made it to the finish line. Find your way back to the game."
  noindex
>
  <main class="wrap content-page not-found-page">
    <span class="round-banner">404</span>
    <section class="not-found-grid" aria-labelledby="not-found-title">
      <div class="not-found-copy">
        <h1 class="display" id="not-found-title">Packet lost!</h1>
        <p class="lede">This page never made it to the finish line. The speed test says 0 Mbps, and for once nobody guessed it.</p>
        <div class="not-found-actions">
          <a class="go" href="/">Start a game</a>
          <a class="guess-button" href="/how-to-play/">How to play</a>
        </div>
      </div>

      <article class="not-found-meter stk">
        <svg
          class="not-found-gauge"
          viewBox="0 0 400 390"
          role="img"
          aria-labelledby="not-found-gauge-title not-found-gauge-description"
        >
          <title id="not-found-gauge-title">PAGE NOT FOUND: 0 Mbps</title>
          <desc id="not-found-gauge-description">A static speed gauge with its needle pinned at zero.</desc>
          <path class="not-found-track-outline" d="M70.1 260 A150 150 0 1 1 329.9 260" />
          <path class="not-found-track" d="M70.1 260 A150 150 0 1 1 329.9 260" />
          <g class="not-found-ticks" aria-hidden="true">
            <text x="103" y="241">0</text>
            <text x="88" y="185">5</text>
            <text x="103" y="129">10</text>
            <text x="144" y="88">25</text>
            <text x="200" y="73">50</text>
            <text x="256" y="88">100</text>
            <text x="297" y="129">250</text>
            <text x="312" y="185">500</text>
            <text x="297" y="241">1000</text>
          </g>
          <g class="not-found-needle" transform="rotate(-120 200 185)">
            <path d="M194 185 L200 90 L206 185 Z" />
          </g>
          <circle class="not-found-hub" cx="200" cy="185" r="15" />
          <text class="not-found-readout-label" x="200" y="244">DOWNLOAD</text>
          <text class="not-found-readout" x="200" y="286">0</text>
          <text class="not-found-unit" x="200" y="309">Mbps</text>
          <rect class="not-found-stamp" x="112" y="333" width="176" height="34" rx="17" />
          <text class="not-found-stamp-text" x="200" y="355">PAGE NOT FOUND</text>
        </svg>
      </article>
    </section>

    <nav class="not-found-links" aria-label="More places to go">
      <a class="not-found-link stk" href="/story/">
        <span>Our story</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="not-found-link stk" href="/stats/">
        <span>Live stats</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="not-found-link stk" href="/how-much-internet-speed-do-i-need/">
        <span>Speed calculator</span>
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </main>
</Base>

<style>
  .not-found-page {
    max-width: 1080px;
    padding-top: 24px;
  }

  .not-found-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }

  .not-found-copy h1 {
    margin: 0 0 16px;
    font-size: clamp(44px, 7vw, 82px);
    line-height: 0.92;
  }

  .not-found-copy .lede {
    max-width: 48ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.5;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
  }

  .not-found-actions .go,
  .not-found-actions .guess-button {
    min-height: 54px;
    text-decoration: none;
  }

  .not-found-actions .guess-button {
    padding-inline: 18px;
  }

  .not-found-meter {
    position: relative;
    width: 100%;
    padding: clamp(12px, 2vw, 22px);
    background: linear-gradient(145deg, var(--surface), var(--bg));
    transform: rotate(1deg);
  }

  .not-found-meter::before {
    position: absolute;
    top: -11px;
    left: 28px;
    width: 82px;
    height: 22px;
    background: color-mix(in srgb, var(--accent) 55%, transparent);
    content: "";
    transform: rotate(-5deg);
  }

  .not-found-gauge {
    display: block;
    width: 100%;
    overflow: visible;
  }

  .not-found-track-outline,
  .not-found-track {
    fill: none;
    stroke-linecap: round;
  }

  .not-found-track-outline {
    stroke: var(--ink);
    stroke-width: 36;
  }

  .not-found-track {
    stroke: var(--soft);
    stroke-width: 30;
  }

  .not-found-ticks {
    fill: var(--muted);
    font:
      700 15px "Bricolage Grotesque Variable",
      sans-serif;
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .not-found-needle {
    fill: var(--ink);
  }

  .not-found-hub {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 5;
  }

  .not-found-readout-label,
  .not-found-unit {
    fill: var(--muted);
    font-family: "Figtree Variable", sans-serif;
    font-weight: 800;
    text-anchor: middle;
  }

  .not-found-readout-label {
    font-size: 12px;
    letter-spacing: 1px;
  }

  .not-found-readout {
    fill: var(--ink);
    font:
      800 58px/1 "Bricolage Grotesque Variable",
      sans-serif;
    text-anchor: middle;
  }

  .not-found-unit {
    font-size: 13px;
  }

  .not-found-stamp {
    fill: var(--accent);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .not-found-stamp-text {
    fill: var(--on-accent);
    font:
      800 12px "Bricolage Grotesque Variable",
      sans-serif;
    letter-spacing: 1px;
    text-anchor: middle;
  }

  .not-found-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 34px;
  }

  .not-found-link {
    display: flex;
    min-height: 62px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    color: var(--ink);
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition: transform 0.12s ease;
  }

  .not-found-link:nth-child(1) {
    transform: rotate(-0.7deg);
  }

  .not-found-link:nth-child(2) {
    transform: rotate(0.5deg);
  }

  .not-found-link:nth-child(3) {
    transform: rotate(-0.4deg);
  }

  .not-found-link:hover {
    transform: translateY(-3px) rotate(-0.8deg);
  }

  .not-found-link span:last-child {
    color: var(--muted);
    font-size: 20px;
  }

  @media (max-width: 760px) {
    .not-found-page {
      padding-top: 18px;
    }

    .not-found-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }

    .not-found-copy h1 {
      font-size: clamp(44px, 12vw, 64px);
    }

    .not-found-meter {
      width: min(100%, 440px);
      margin-inline: auto;
    }

    .not-found-links {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      margin-top: 28px;
    }
  }
</style>
