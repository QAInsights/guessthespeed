---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import { MAX_PLAYERS } from "../lib/room";

const description =
  "A free virtual team building game and remote meeting icebreaker. Play a five-minute Wi-Fi guessing game from a shared link, with no accounts.";

const questions = [
  {
    question: "Is Work mode free?",
    answer:
      "Yes. Work mode is free, needs no account, and works from a room link you can share in your meeting chat.",
  },
  {
    question: "Do teammates need an account?",
    answer:
      "No. Teammates join from the room link or code, choose a face, and add a nickname. There is no sign-up.",
  },
  {
    question: "How many people can play?",
    answer: `A room supports up to ${MAX_PLAYERS} players.`,
  },
  {
    question: "Does the game share my location or IP with teammates?",
    answer:
      "No. Your location and IP address are not shown to teammates. The room shares only the speed numbers measured for that round.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Base
  title="Guess the Wi-Fi: A Free Icebreaker Game for Remote Teams"
  description={description}
  breadcrumb="Work mode"
  modeSwitch="work"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </Fragment>

  <main class="wrap content-page work-page mode-page">
    <header class="work-hero mode-hero">
      <div class="work-hero-copy mode-hero-copy">
        <span class="mode-hero-pill"><Icon name="ph:briefcase-bold" aria-hidden="true" /> Work mode</span>
        <h1 class="display mode-hero-heading">Guess your<br />teammate's <em><span class="wifi-nowrap">Wi-Fi.</span></em></h1>
        <p class="lede mode-hero-lede">
          A free five-minute icebreaker for standups, all-hands, and offsites. No accounts:
          start a room and share its meeting link so everyone can play from their own device.
        </p>
        <p class="work-hero-note">
          <Icon name="ph:users-three-bold" aria-hidden="true" />
          Each round runs on a different teammate's connection.
        </p>
      </div>
      <div class="work-hero-sticker stk mode-hero-visual" aria-label="A quick team icebreaker">
        <span class="work-sticker-spark" aria-hidden="true">✳</span>
        <strong>One guess.<br />One real test.</strong>
        <small>Five minutes together</small>
      </div>
    </header>

    <section class="work-room-card stk" aria-labelledby="work-room-title">
      <div class="work-room-card-copy">
        <span class="work-kicker">Bring the room into your meeting</span>
        <h2 class="display" id="work-room-title">Start with a team room</h2>
        <p>
          Share one link in the call chat. Everyone guesses privately, then the test moves
          to a teammate's device each round.
        </p>
      </div>
      <div class="work-room-actions">
        <button class="go" type="button" data-create-team-room>
          <Icon name="ph:users-three-bold" aria-hidden="true" />
          Start a team room
        </button>
        <form class="room-join-form" data-home-join-form data-work-join-form>
          <label class="sr" for="work-room-code">Room code</label>
          <input
            class="dialog-input"
            id="work-room-code"
            name="code"
            type="text"
            maxlength="9"
            inputmode="text"
            autocomplete="off"
            placeholder="Enter a code"
          />
          <button class="guess-button" type="submit">Join with a code</button>
        </form>
        <p class="room-entry-error" data-room-entry-error role="status" hidden></p>
        <p class="work-classroom-note" data-work-classroom-note hidden>
          Rooms are off in Classroom mode, so student names stay on this device.
        </p>
      </div>
    </section>

    <section class="work-steps" aria-labelledby="work-steps-title">
      <div>
        <span class="work-kicker">A quick team ritual</span>
        <h2 class="display" id="work-steps-title">How it works</h2>
        <p>Give the team one small thing to guess before the next agenda item.</p>
      </div>
      <ol>
        <li><span>01</span><p>The host shares the room link in the call chat.</p></li>
        <li><span>02</span><p>Everyone picks a face and locks in a private guess.</p></li>
        <li><span>03</span><p>The test hops to the next teammate each round.</p></li>
      </ol>
    </section>

    <div class="work-detail-grid">
      <article class="content-card stk">
        <span class="work-kicker">One office network?</span>
        <h2>Office on one Wi-Fi?</h2>
        <p>
          Turn off <strong>Rotate each round</strong> in the room bar and the host screen
          keeps running the test. The team can still take turns guessing together.
        </p>
      </article>
      <article class="content-card stk">
        <span class="work-kicker">Why it works</span>
        <h2>Why it works as an icebreaker</h2>
        <p>
          Everyone has an opinion about their Wi-Fi. It is familiar, quick to explain, and
          gives the whole call a reason to compare guesses without turning a meeting into
          another long activity.
        </p>
      </article>
    </div>

    <aside class="work-privacy stk" aria-labelledby="work-privacy-title">
      <div class="work-privacy-icon" aria-hidden="true"><Icon name="ph:lock-key-bold" /></div>
      <div>
        <h2 id="work-privacy-title">A small privacy note</h2>
        <p>
          No accounts are needed. Guesses stay hidden until the reveal. The tester's measured
          speed is shown to the room. Rooms are deleted after six hours without activity, and
          the game is not tied to anyone in its stats.
        </p>
        <a href="/privacy/">Read the privacy details</a>
      </div>
    </aside>

    <section class="work-faq" aria-labelledby="work-faq-title">
      <span class="work-kicker">Good to know</span>
      <h2 class="display" id="work-faq-title">Work mode FAQ</h2>
      <div class="work-faq-list">
        {questions.map(({ question, answer }) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <nav class="work-related-links" aria-label="More ways to play">
      <a href="/">Play Guess the Speed</a>
      <a href="/speed-test-game/">How the speed test game works</a>
      <a href="/privacy/">Privacy</a>
    </nav>
  </main>
</Base>

<script>
  import "../scripts/room-client";
</script>
