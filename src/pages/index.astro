---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { ROLES } from '../lib/game';

const roleChoices = ROLES;
const homeTitle = 'Guess the Speed | The Internet Speed Guessing Game for Families';
const homeDescription =
  "A free family game and two-minute filler: everyone guesses the Wi-Fi download and upload speed, then a real speed test reveals who came closest. Play on one screen or on everyone's phone.";
const homeSchema: Record<string, unknown>[] = [
  {
    '@type': 'WebApplication',
    name: 'Guess the Speed',
    url: 'https://guessthespeed.com/',
    description: homeDescription,
    applicationCategory: 'GameApplication',
    genre: ['Family game', 'Party game', 'Filler game'],
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and a modern browser',
    isAccessibleForFree: true,
    inLanguage: 'en',
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    author: { '@id': 'https://guessthespeed.com/#author' },
    publisher: { '@id': 'https://guessthespeed.com/#author' },
    screenshot: [
      'https://guessthespeed.com/screenshots/home-wide.png',
      'https://guessthespeed.com/screenshots/home-narrow.png',
    ],
    featureList: [
      'Run a real speed test against Cloudflare’s network in the browser.',
      'Play with one or more players on one screen, with room-code games supporting up to 12 players.',
      'Use room codes to play on separate phones.',
      'The room server hides guesses from other players until the test result.',
      'Award 3, 2, and 1 place points plus a spot-on bonus for each speed guess within 5%.',
      'Require an average miss of 50% or less to earn place points.',
      'Choose light, dark, or seasonal themes.',
      'Play with optional sound effects.',
      'Play without accounts or cookies.',
      'Play a quick round in about two minutes as a filler game between longer games.',
    ],
  },
];
---

<Base title={homeTitle} description={homeDescription} schema={homeSchema}>
  <main class="wrap game-main">
    <section class="stage" aria-label="Speed test game">
      <div class="intro">
        <div class="mode-switch" role="radiogroup" aria-label="Mode" data-mode-switch>
          <button type="button" role="radio" aria-checked="true" tabindex="0" data-mode-option="game"><Icon name="ph:game-controller-bold" />Game</button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-mode-option="dev"><Icon name="ph:code-bold" />Dev</button>
        </div>
        <div class="round" data-round-banner><Icon name="ph:flag-checkered-fill" /><span data-round-label>Round 1 of 3</span></div>
        <h1 class="display" data-game-title>Guess the <span class="wifi-nowrap">Wi-Fi</span>. <em>Beat the family.</em></h1>
        <h2 class="display dev-title" data-dev-title hidden>Dev mode</h2>
        <p data-game-lede>Guess the download and upload. Run a real speed test. Closest guesses score!</p>
        <p class="dev-lede" data-dev-lede hidden>Raw Cloudflare speed test data. No game, no scores.</p>
        <p class="play-stat" data-play-stat hidden><a href="/stats/"><span>🎉{' '}<span data-play-stat-text></span></span></a></p>
      </div>

      <div class="gauge-card stk">
        <div class="gauge" data-gauge>
          <svg viewBox="0 0 400 320" role="img" aria-label="Live internet speed gauge">
            <path class="track-o" data-arc data-cx="200" data-cy="185" data-r="150" data-start="-120" data-sweep="240"></path>
            <path class="track" data-arc data-cx="200" data-cy="185" data-r="150" data-start="-120" data-sweep="240"></path>
            <path class="gauge-fill" data-arc data-cx="200" data-cy="185" data-r="150" data-start="-120" data-sweep="240"></path>
            <g data-ticks data-cx="200" data-cy="185" data-r="108" data-start="-120" data-sweep="240"></g>
            <g class="gauge-needle">
              <path class="needle" d="M194 185 L200 80 L206 185 Z"></path>
              <circle class="hub" cx="200" cy="185" r="15"></circle>
            </g>
          </svg>
          <div class="readout">
            <span class="mode" data-mode>Download</span>
            <span class="num" data-live>0</span>
            <span class="unit" data-unit>Mbps</span>
          </div>
        </div>
        <div class="phase-status">
          <span class="live-dot" data-live-dot aria-hidden="true" hidden></span>
          <div class="phase" data-phase-label aria-live="polite">
            <span data-phase-text>Ready when you are</span>
            <span class="elapsed" data-elapsed aria-hidden="true" hidden></span>
            <span class="slow-hint" data-slow-hint hidden>Big file still on its way...</span>
          </div>
        </div>
        <div class="test-progress" data-test-progress role="progressbar" aria-label="Speed test progress" aria-valuemin="0" aria-valuemax="13" aria-valuenow="0" hidden>
          <div class="test-progress-fill" data-progress-fill></div>
        </div>
        <button class="go" type="button" data-start-btn disabled>
          <Icon name="ph:lightning-fill" />
          <span data-start-label>Waiting for guesses</span>
        </button>
        <p class="room-waiting" data-room-waiting hidden></p>
        <div class="winner" data-winner-banner hidden aria-live="polite"></div>
        <p class="error-note" data-error-note hidden></p>
      </div>

      <div class="stats" aria-label="Latest speed test results">
        <div class="stat stk"><span><Icon name="ph:timer-fill" />Ping</span><div><b data-result="ping">-</b><small>ms</small></div></div>
        <div class="stat stk"><span><Icon name="ph:arrow-down-fill" />Download</span><div><b data-result="down">-</b><small>Mbps</small></div></div>
        <div class="stat stk"><span><Icon name="ph:arrow-up-fill" />Upload</span><div><b data-result="up">-</b><small>Mbps</small></div></div>
      </div>
    </section>

    <section class="room-bar stk" data-room-bar aria-label="Multiplayer room" hidden>
      <div class="room-bar-code">
        <span>Room code</span>
        <strong data-room-code></strong>
      </div>
      <div class="room-bar-actions">
        <div class="room-tester-picker" data-room-tester-control hidden>
          <button class="guess-button room-tester-trigger" type="button" data-room-tester-trigger aria-label="Who runs the test?" aria-haspopup="listbox" aria-expanded="false" aria-controls="room-tester-menu">
            <span>Who runs the test?</span>
            <strong data-room-tester-value>This screen</strong>
            <Icon name="ph:caret-down-bold" aria-hidden="true" />
          </button>
          <div class="room-tester-menu" id="room-tester-menu" data-room-tester-menu role="listbox" aria-label="Who runs the test?" hidden></div>
        </div>
        <span class="room-tester-chip" data-room-tester-chip hidden></span>
        <button class="guess-button room-stop-test" type="button" data-room-stop-test hidden>Stop test</button>
        <button class="guess-button" type="button" data-show-room-qr>Show QR</button>
        <button class="guess-button" type="button" data-copy-room-link>Copy link</button>
        <span class="room-connection" data-room-connection aria-live="polite">Connecting...</span>
        <a class="ghost" href="/" data-leave-room>Leave room</a>
      </div>
    </section>

    <section class="dev-console" aria-labelledby="dev-console-title">
      <div class="dev-console-head">
        <div>
          <h2 class="display" id="dev-console-title">Speed test diagnostics</h2>
          <p>Live measurements from this browser. Only the latest run is kept in memory.</p>
        </div>
        <div class="dev-export">
          <button class="guess-button" type="button" data-copy-json>Copy JSON</button>
          <button class="guess-button" type="button" data-download-json>Download JSON</button>
          <span data-copy-status aria-live="polite"></span>
        </div>
      </div>
      <div class="dev-panels">
        <article class="dev-panel stk" data-panel="connection">
          <h3>Connection</h3>
          <div data-connection-content><p>Choose Dev in the Game / Dev switch at the top of the home screen to check this connection.</p></div>
        </article>
        <article class="dev-panel stk" data-panel="summary">
          <h3>Summary</h3>
          <div data-summary-content><p>Run a speed test to see results.</p></div>
        </article>
        <article class="dev-panel stk" data-panel="latency">
          <h3>Latency</h3>
          <div data-latency-content><p>Latency samples will appear here.</p></div>
        </article>
        <article class="dev-panel stk dev-panel-wide" data-panel="requests">
          <h3>Requests</h3>
          <div data-requests-content><p>Bandwidth requests will appear here.</p></div>
        </article>
        <article class="dev-panel stk dev-panel-wide" data-panel="percentile">
          <h3>How the number was picked</h3>
          <div data-percentile-content><p>Counted samples and the final percentile will appear here.</p></div>
        </article>
        <article class="dev-panel stk" data-panel="config">
          <h3>Test plan and config</h3>
          <div data-config-content></div>
        </article>
        <article class="dev-panel stk" data-panel="browser">
          <h3>Browser</h3>
          <div data-browser-content></div>
        </article>
      </div>
    </section>

    <section class="room-entry stk" data-room-entry aria-labelledby="room-entry-title">
      <div class="room-entry-copy">
        <span class="room-kicker">A room for everyone</span>
        <h2 class="display" id="room-entry-title">Play on everyone’s phone</h2>
        <p>Keep every guess on its owner’s screen until the real speed test is done.</p>
      </div>
      <div class="room-entry-actions">
        <button class="go" type="button" data-create-room>Create a room</button>
        <form class="room-join-form" data-home-join-form>
          <label class="sr" for="room-code-input">Room code</label>
          <input class="dialog-input" id="room-code-input" name="code" type="text" maxlength="9" inputmode="text" autocomplete="off" placeholder="Enter a code" />
          <button class="guess-button" type="submit">Join with a code</button>
        </form>
        <p class="room-entry-error" data-room-entry-error role="status" hidden></p>
      </div>
    </section>

    <section aria-labelledby="players-heading" data-game-section>
      <aside
        class="classroom-session-banner stk"
        data-classroom-banner
        aria-label="Classroom game"
        hidden
      >
        <div class="classroom-session-copy">
          <p class="classroom-session-chip" data-classroom-chip aria-live="polite"></p>
          <p class="classroom-session-note" data-classroom-room-note hidden>
            Rooms are off in Classroom mode, so student names stay on this device.
          </p>
        </div>
        <div class="classroom-session-actions">
          <a class="guess-button" href="/classroom/">Class menu</a>
          <button class="ghost classroom-end-button" type="button" data-end-class>
            End class
          </button>
        </div>
      </aside>
      <div class="sec-head">
        <h2 id="players-heading" class="display">Who’s playing?</h2>
        <div class="section-actions">
          <button class="ghost" type="button" data-reset>Reset scores</button>
          <div class="seg" data-view-toggle aria-label="Player view">
            <button type="button" data-view="grid" aria-pressed="true"><Icon name="ph:squares-four-fill" />Cards</button>
            <button type="button" data-view="table" aria-pressed="false"><Icon name="ph:list-bold" />Table</button>
          </div>
        </div>
      </div>
      <div data-players aria-live="polite">
        <div class="p-empty"><span>🏁</span><p>Add the first player</p></div>
      </div>

      <button class="guess-button tv-add-toggle" type="button" data-tv-add-toggle aria-expanded="false" aria-controls="add-player-form" hidden>
        <Icon name="ph:plus-bold" />Add player
      </button>
      <form class="add stk" id="add-player-form" data-add-form>
        <div>
          <label class="lbl" for="player-name">Player name</label>
          <input id="player-name" name="name" maxlength="16" autocomplete="off" placeholder="e.g. Grandpa Raj" required />
        </div>
        <fieldset class="role-fieldset">
          <legend class="lbl">Pick a face</legend>
          <div data-emoji-picker>
            {roleChoices.map((choice, index) => (
              <label title={choice.role}>
                <input type="radio" name="emoji" value={index} checked={index === 0} />
                <span>{choice.emoji}</span>
                <small>{choice.role}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <button class="go" type="submit"><Icon name="ph:plus-bold" />Add player</button>
      </form>
    </section>

    <section class="how" aria-labelledby="how-round-heading">
      <div>
        <h2 id="how-round-heading" class="display">How a round works</h2>
        <ol>
          <li><b>1</b><span>Each player privately guesses download and upload speed in Mbps.</span></li>
          <li><b>2</b><span>Press start. A real test runs against Cloudflare’s network.</span></li>
          <li><b>3</b><span>The closest average guess earns the most points.</span></li>
        </ol>
        <p class="learn-more">
          Learn more: <a href="/how-it-works/">How the test works</a>,{' '}
          <a href="/internet-speed-101/">Internet speed 101</a>,{' '}
          <a href="/speed-test-game/">Speed test game</a>,{' '}
          <a href="/family-game-night-ideas/">Game night ideas</a>, and{' '}
          <a href="/internet-speed-lesson-for-kids/">Classroom lesson</a>.
        </p>
      </div>
      <p class="note stk"><strong>Why both numbers?</strong> Most home plans upload more slowly than they download. Guessing both makes the game extra interesting.</p>
    </section>

    <aside class="story-teaser note stk" aria-labelledby="story-teaser-title">
      <h2 id="story-teaser-title">Why this game exists</h2>
      <p>It started with a speed test on our living-room TV and two kids who guess the number right every time. Dad loses on purpose. Mostly.</p>
      <a href="/story/">Read our story</a>
    </aside>

    <aside class="classroom-teaser stk" aria-label="Classroom mode">
      <p>Teaching a class? <a href="/classroom/">Try Classroom mode</a>.</p>
    </aside>
  </main>

  <dialog class="sticker-dialog" data-guess-dialog aria-labelledby="guess-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="guess-title" class="display">Your speed guess</h2>
        <button class="dialog-close" type="button" data-close-guess aria-label="Close guess"><Icon name="ph:x-bold" /></button>
      </div>
      <div class="guess-person"><span data-guess-emoji>🙂</span><b data-guess-player>Player</b></div>
      <form class="dialog-form" data-guess-form>
        <label class="dialog-field">Download
          <input class="dialog-input" name="down" type="number" inputmode="decimal" min="0" step="any" placeholder="Your guess in Mbps" />
          <small>How fast will a big download feel?</small>
        </label>
        <label class="dialog-field">Upload
          <input class="dialog-input" name="up" type="number" inputmode="decimal" min="0" step="any" placeholder="Your guess in Mbps" />
          <small>How fast will sharing a file feel?</small>
        </label>
        <p class="guess-hint">Your guesses stay hidden until the test is over.</p>
        <div class="dialog-actions">
          <button class="go" type="submit"><Icon name="ph:lock-key-fill" />Lock it in</button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog class="sticker-dialog" data-start-confirm-dialog aria-labelledby="start-confirm-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="start-confirm-title" class="display">Start anyway?</h2>
      </div>
      <p class="start-confirm-message" data-start-confirm-message></p>
      <p class="start-confirm-note">They'll sit this round out with 0 points.</p>
      <div class="dialog-actions">
        <button class="go" type="button" data-start-anyway>Start anyway</button>
        <button class="guess-button" type="button" data-wait-for-them>Wait for them</button>
      </div>
    </div>
  </dialog>

  <dialog class="sticker-dialog room-join-dialog" data-room-join-dialog aria-labelledby="room-join-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="room-join-title" class="display">Join the room</h2>
        <a class="dialog-close" href="/" aria-label="Leave room"><Icon name="ph:x-bold" /></a>
      </div>
      <p class="room-join-code">Room <strong data-room-join-code></strong></p>
      <form class="dialog-form" data-room-join-form>
        <label class="dialog-field">Your name
          <input class="dialog-input" name="name" type="text" maxlength="16" autocomplete="off" required />
        </label>
        <fieldset class="edit-role-fieldset">
          <legend class="lbl">Pick your face</legend>
          <div data-room-emoji-picker>
            {roleChoices.map((choice, index) => (
              <label title={choice.role}>
                <input type="radio" name="emoji" value={index} checked={index === 0} />
                <span>{choice.emoji}</span>
                <small>{choice.role}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="room-join-error" data-room-join-error role="status" hidden></p>
        <div class="dialog-actions">
          <button class="go" type="submit"><Icon name="ph:user-plus-fill" />Join game</button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog class="sticker-dialog room-qr-dialog" data-room-qr-dialog aria-labelledby="room-qr-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="room-qr-title" class="display">Scan to join</h2>
        <button class="dialog-close" type="button" data-close-room-qr aria-label="Close QR code"><Icon name="ph:x-bold" /></button>
      </div>
      <div class="room-qr-image" data-room-qr-image></div>
      <p class="room-qr-code">Room code <strong data-room-qr-code></strong></p>
      <button class="go" type="button" data-copy-room-qr-link>Copy link</button>
    </div>
  </dialog>

  <dialog class="sticker-dialog room-ended-dialog" data-room-ended-dialog aria-labelledby="room-ended-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="room-ended-title" class="display">This room has ended</h2>
        <button class="dialog-close" type="button" data-close-room-ended aria-label="Close room ended message"><Icon name="ph:x-bold" /></button>
      </div>
      <p>Room codes expire after six hours without activity.</p>
      <a class="go" href="/">Start a local game</a>
    </div>
  </dialog>

  <dialog class="sticker-dialog" data-edit-dialog aria-labelledby="edit-title">
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="edit-title" class="display">Edit player</h2>
        <button class="dialog-close" type="button" data-close-edit aria-label="Close edit player"><Icon name="ph:x-bold" /></button>
      </div>
      <form class="dialog-form" data-edit-form>
        <label class="dialog-field">Player name
          <input class="dialog-input" name="name" type="text" maxlength="16" autocomplete="off" required />
        </label>
        <fieldset class="edit-role-fieldset">
          <legend class="lbl">Pick a face</legend>
          <div data-emoji-picker>
            {roleChoices.map((choice, index) => (
              <label title={choice.role}>
                <input type="radio" name="emoji" value={index} />
                <span>{choice.emoji}</span>
                <small>{choice.role}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="dialog-actions">
          <button class="guess-button" type="button" data-cancel-edit>Cancel</button>
          <button class="go" type="submit">Save player</button>
        </div>
      </form>
    </div>
  </dialog>

  <dialog class="champion-dialog" data-champion-dialog aria-labelledby="champion-title">
    <div class="dialog-inner">
      <div class="champion-confetti" data-champion-confetti aria-hidden="true"></div>
      <div class="dialog-head">
        <h2 id="champion-title" class="champion-title display">Game night champion!</h2>
        <button class="dialog-close" type="button" data-close-champion aria-label="Close champion results"><Icon name="ph:x-bold" /></button>
      </div>
      <p class="champion-intro" data-champion-message></p>
      <div class="podium" data-podium></div>
      <div class="champion-actions">
        <button class="go" type="button" data-play-again><Icon name="ph:arrow-counter-clockwise-bold" />Play again</button>
        <button class="guess-button" type="button" data-share-result><Icon name="ph:share-network-bold" />Share result</button>
        <p class="share-status" data-share-status aria-live="polite"></p>
      </div>
    </div>
  </dialog>

  <script>
    import '../scripts/room-client';
    import '../scripts/game-client';
    import '../scripts/dev-client';
    import { loadPlayStat } from '../scripts/stats-client';

    requestAnimationFrame(() => {
      window.setTimeout(() => void loadPlayStat(), 0);
    });
  </script>
</Base>
