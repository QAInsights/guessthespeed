---
import SpeedSchoolIndex from '../../../components/SpeedSchoolIndex.astro';
import { SCHOOL_PAGE_COUNT } from '../../../lib/speed-school';

export function getStaticPaths() {
  return Array.from({ length: SCHOOL_PAGE_COUNT - 1 }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const page = Number(Astro.params.page);
---

<SpeedSchoolIndex page={page} />
