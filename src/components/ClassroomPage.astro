---
import Base from "../layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { MAX_NAME_LENGTH } from "../lib/limits";
import { formatNumber, type Locale } from "../lib/i18n";
import { t } from "../lib/messages";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const msg = (
  key: Parameters<typeof t>[0],
  params: Record<string, string | number | boolean> = {},
) => t(key, params, locale);
const description = msg("classroom_page_description");

const questions = [
  {
    question: msg("classroom_page_faq_question_1"),
    answer: msg("classroom_page_faq_answer_1"),
  },
  {
    question: msg("classroom_page_faq_question_2"),
    answer: msg("classroom_page_faq_answer_2"),
  },
  {
    question: msg("classroom_page_faq_question_3"),
    answer: msg("classroom_page_faq_answer_3"),
  },
  {
    question: msg("classroom_page_faq_question_4"),
    answer: msg("classroom_page_faq_answer_4"),
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: locale,
  mainEntity: questions.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<Base
  title={msg("classroom_page_title")}
  description={description}
  breadcrumb={msg("classroom_page_breadcrumb")}
  modeSwitch="classroom"
  locale={locale}
  translatedPage="/classroom/"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    ></script>
  </Fragment>

  <main class="wrap content-page classroom-page mode-page">
    <header class="classroom-hero mode-hero">
      <div class="classroom-hero-copy mode-hero-copy">
        <span class="mode-hero-pill">{msg("footer_classroom_mode")}</span>
        <h1 class="display mode-hero-heading">{msg("classroom_page_hero_heading_first")}<br /><em><span class="wifi-nowrap">{msg("classroom_page_hero_heading_second")}</span></em></h1>
        <p class="lede mode-hero-lede">{msg("classroom_page_hero_lede")}</p>
        <p class="privacy-sticker stk">
          <span aria-hidden="true">🔒</span>
          <strong>{msg("classroom_page_hero_privacy")}</strong>
        </p>
      </div>
      <div class="classroom-team-stickers mode-hero-visual" aria-label={msg("classroom_page_team_scores_aria")}>
        <article class="classroom-team-sticker classroom-team-sticker-rockets">
          <span class="classroom-team-name"><span aria-hidden="true">🚀</span> {msg("classroom_page_team_rockets")}</span>
          <strong>{formatNumber(12, locale)}<small>{msg("classroom_page_points_short")}</small></strong>
        </article>
        <article class="classroom-team-sticker classroom-team-sticker-lightning">
          <span class="classroom-team-name"><span aria-hidden="true">⚡</span> {msg("classroom_page_team_lightning")}</span>
          <strong>{formatNumber(9, locale)}<small>{msg("classroom_page_points_short")}</small></strong>
        </article>
        <article class="classroom-team-sticker classroom-team-sticker-dolphins">
          <span class="classroom-team-name"><span aria-hidden="true">🐬</span> {msg("classroom_page_team_dolphins")}</span>
          <strong>{formatNumber(7, locale)}<small>{msg("classroom_page_points_short")}</small></strong>
        </article>
      </div>
    </header>

    <section class="classroom-tool" aria-labelledby="class-picker-title">
      <div class="classroom-tool-heading">
        <div>
          <span class="classroom-kicker">{msg("classroom_page_teaching_desk")}</span>
          <h2 id="class-picker-title">{msg("classroom_page_choose_class")}</h2>
          <p>{msg("classroom_page_class_intro")}</p>
        </div>
        <span class="class-count-badge" data-class-count>{msg("classroom_ui_class_count_many", { count: formatNumber(0, locale) })}</span>
      </div>

      <div
        class="class-picker"
        data-class-list
        aria-label={msg("classroom_page_saved_classes")}
      ></div>

      <p class="classroom-toast" data-toast role="status" aria-live="polite"></p>

      <div class="classroom-workspace">
        <section
          class="classroom-panel stk"
          data-class-editor
          aria-labelledby="editor-title"
          hidden
        >
          <div class="panel-heading">
            <div>
              <span class="classroom-kicker">{msg("classroom_page_class_details")}</span>
              <h2 id="editor-title">{msg("classroom_page_build_roster")}</h2>
            </div>
            <button
              class="quiet-button"
              type="button"
              data-delete-class
              aria-label={msg("classroom_page_delete_class")}
            >{msg("classroom_page_delete_class")}</button>
          </div>

          <label class="classroom-field">
            <span>{msg("classroom_page_class_name")}</span>
            <input
              class="classroom-input"
              data-class-name
              type="text"
              maxlength="24"
              autocomplete="off"
              required
            />
          </label>

          <fieldset class="emoji-field">
          <legend>{msg("classroom_page_choose_sticker")}</legend>
            <div
              class="emoji-picker class-emoji-picker"
              data-class-emoji-picker
              role="group"
              aria-label={msg("classroom_page_sticker_aria")}
            ></div>
          </fieldset>

          <form class="roster-form" data-roster-form>
            <label class="classroom-field" for="roster-paste">
              <span>{msg("classroom_page_paste_list")}</span>
              <textarea
                class="classroom-input roster-textarea"
                id="roster-paste"
                data-roster-text
                rows="5"
                placeholder={msg("classroom_page_roster_placeholder")}
              ></textarea>
              <small>{msg("classroom_page_roster_instructions")}</small>
            </label>
            <button class="guess-button classroom-secondary" type="submit">
              {msg("classroom_page_add_students")}
            </button>
          </form>

          <div class="roster-heading">
            <h3>{msg("classroom_page_student_roster")}</h3>
            <span data-student-count>{msg("classroom_ui_student_count_display", { count: formatNumber(0, locale), limit: formatNumber(40, locale) })}</span>
          </div>
          <div
            class="student-roster"
            data-student-roster
            aria-label={msg("classroom_page_students_aria")}
          ></div>
          <p class="roster-empty" data-roster-empty>
            {msg("classroom_page_roster_empty")}
          </p>

          <div class="roster-actions">
            <button class="quiet-button" type="button" data-clear-list>
              {msg("classroom_page_clear_list")}
            </button>
          </div>
        </section>

        <section
          class="classroom-panel play-panel stk"
          data-play-panel
          aria-labelledby="play-title"
          hidden
        >
          <div class="panel-heading">
            <div>
              <span class="classroom-kicker">{msg("classroom_page_game_setup")}</span>
              <h2 id="play-title">{msg("classroom_page_play_title")}</h2>
            </div>
            <span class="play-ready" data-play-ready>{msg("classroom_page_roster_ready")}</span>
          </div>

          <fieldset class="mode-picker">
            <legend>{msg("classroom_page_choose_round")}</legend>
            <div class="mode-cards">
              <label class="mode-card">
                <input type="radio" name="classroomMode" value="teams" checked />
                <span class="mode-card-icon" aria-hidden="true">🚀</span>
                <span>
                  <strong>{msg("classroom_page_team_game")}</strong>
                  <small>{msg("classroom_page_team_game_description")}</small>
                </span>
              </label>
              <label class="mode-card">
                <input
                  type="radio"
                  name="classroomMode"
                  value="spotlight"
                />
                <span class="mode-card-icon" aria-hidden="true">🌟</span>
                <span>
                  <strong>{msg("classroom_page_spotlight_round")}</strong>
                  <small>{msg("classroom_page_spotlight_description")}</small>
                </span>
              </label>
            </div>
          </fieldset>

          <div class="team-setup" data-team-setup>
            <div class="setup-row">
              <label class="classroom-field compact-field" for="team-count">
                <span>{msg("classroom_page_team_count")}</span>
                <input
                  class="classroom-input stepper-input"
                  id="team-count"
                  data-team-count
                  type="number"
                  min="2"
                  max="6"
                  step="1"
                  value="4"
                />
              </label>
              <button
                class="guess-button classroom-secondary"
                type="button"
                data-shuffle-teams
              >{msg("classroom_page_shuffle_teams")}</button>
            </div>
            <p class="setup-help">
              {msg("classroom_page_team_help")}
            </p>
            <div
              class="team-preview"
              data-team-preview
              aria-live="polite"
              aria-label={msg("classroom_page_team_preview_aria")}
            ></div>
          </div>

          <div class="spotlight-setup" data-spotlight-setup hidden>
            <div class="setup-row">
              <label class="classroom-field compact-field" for="spotlight-count">
                <span>{msg("classroom_page_spotlight_count")}</span>
                <input
                  class="classroom-input stepper-input"
                  id="spotlight-count"
                  data-spotlight-count
                  type="number"
                  min="2"
                  max="8"
                  step="1"
                  value="4"
                />
              </label>
              <button
                class="go spotlight-spin"
                type="button"
                data-spin-spotlight
              >{msg("classroom_page_spin")}</button>
            </div>
            <div
              class="spotlight-preview"
              data-spotlight-preview
              aria-live="polite"
              aria-label={msg("classroom_page_spotlight_selection_aria")}
            >
              <p class="preview-placeholder">
                {msg("classroom_page_spotlight_placeholder")}
              </p>
            </div>
            <button
              class="text-button"
              type="button"
              data-reset-spotlight
            >{msg("classroom_page_reset_spotlight")}</button>
          </div>

          <p class="no-students-note" data-no-students>
            {msg("classroom_page_need_two_students")}
          </p>
          <button
            class="go start-class-game"
            type="button"
            data-start-class
            disabled
          >
            {msg("classroom_page_start_game")}
          </button>
          <p class="game-note" data-room-start-note hidden>
            {msg("classroom_page_room_start_note")}
          </p>
        </section>
      </div>

      <details class="classroom-backup stk">
        <summary>{msg("classroom_page_backup_summary")}</summary>
        <div class="backup-content">
          <p>{msg("classroom_page_backup_description")}</p>
          <div class="backup-actions">
            <button class="guess-button classroom-secondary" type="button" data-export>
              {msg("classroom_page_export_file")}
            </button>
            <label class="file-picker">
              <span>{msg("classroom_page_import_file")}</span>
              <input type="file" data-import accept="application/json,.json" />
            </label>
            <button
              class="quiet-button danger-button"
              type="button"
              data-delete-all
            >{msg("classroom_page_delete_all")}</button>
          </div>
        </div>
      </details>
    </section>

    <section class="classroom-explainer content-card stk" aria-labelledby="lesson-title">
      <span class="classroom-kicker">{msg("classroom_page_four_steps")}</span>
      <h2 id="lesson-title">{msg("classroom_page_lesson_title")}</h2>
      <ol class="lesson-steps">
        <li>
          <strong>{msg("classroom_page_project_step")}</strong>
          {msg("classroom_page_project_copy")}
        </li>
        <li>
          <strong>{msg("classroom_page_huddle_step")}</strong>
          {msg("classroom_page_huddle_copy")}
        </li>
        <li>
          <strong>{msg("classroom_page_captain_step")}</strong>
          {msg("classroom_page_captain_copy")}
        </li>
        <li>
          <strong>{msg("classroom_page_gauge_step")}</strong>
          {msg("classroom_page_gauge_copy")}
        </li>
      </ol>
      <aside class="projector-tip stk">
        <strong>{msg("classroom_page_projector_tip")}</strong>
        <span>{msg("classroom_page_projector_copy")}</span>
      </aside>
      <p>
        {msg("classroom_page_lesson_prompt")}{" "}
        <a href="/internet-speed-lesson-for-kids/">{msg("classroom_page_lesson_link")}</a>.
      </p>
      <h3>{msg("classroom_page_privacy_title")}</h3>
      <p>{msg("classroom_page_privacy_copy")}</p>
      <div class="classroom-faq">
        <h3>{msg("classroom_page_faq_title")}</h3>
        {questions.map(({ question, answer }) => (
          <section>
            <h4>{question}</h4>
            <p>{answer}</p>
          </section>
        ))}
      </div>
    </section>
  </main>

  <dialog
    class="sticker-dialog classroom-dialog"
    data-student-dialog
    aria-labelledby="student-dialog-title"
  >
    <div class="dialog-inner">
      <div class="dialog-head">
        <h2 id="student-dialog-title">{msg("classroom_page_edit_student")}</h2>
        <button
          class="dialog-close"
          type="button"
          data-close-student
          aria-label={msg("classroom_page_close_student")}
        ><Icon name="ph:x-bold" /></button>
      </div>
      <form class="dialog-form" data-student-form>
        <label class="dialog-field">
          {msg("classroom_page_student_name")}
          <input
            class="dialog-input"
            data-student-name
            name="name"
            type="text"
            maxlength={MAX_NAME_LENGTH}
            autocomplete="off"
            required
          />
        </label>
        <fieldset class="emoji-field">
          <legend>{msg("classroom_page_choose_face")}</legend>
          <div
            class="emoji-picker student-emoji-picker"
            data-student-emoji-picker
            role="group"
            aria-label={msg("classroom_page_student_face_aria")}
          ></div>
        </fieldset>
        <p class="dialog-error" data-student-error role="alert"></p>
        <div class="dialog-actions">
          <button
            class="quiet-button danger-button"
            type="button"
            data-remove-student
          >{msg("classroom_page_remove_student")}</button>
          <button class="go" type="submit">{msg("classroom_page_save_student")}</button>
        </div>
      </form>
    </div>
  </dialog>

  <script>
    import "../scripts/classroom-client";
  </script>
</Base>

<style>
  .classroom-page {
    max-width: 1180px;
    padding-top: 0;
  }

  .classroom-page [hidden] {
    display: none !important;
  }

  .classroom-team-stickers {
    display: grid;
    gap: 14px;
    padding: 14px 12px;
  }

  .classroom-team-sticker {
    display: flex;
    min-height: 78px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 17px;
    border: var(--card-border) solid var(--on-pastel);
    border-radius: var(--r);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    color: var(--on-pastel);
  }

  .classroom-team-sticker-rockets {
    background: #fff1b8;
    transform: translateX(-8px);
  }

  .classroom-team-sticker-lightning {
    background: #e3f5fa;
    transform: translateX(18px);
  }

  .classroom-team-sticker-dolphins {
    background: #f3e9ff;
    transform: translateX(2px);
  }

  .classroom-team-name {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .classroom-team-name span {
    font-size: 1.65rem;
  }

  .classroom-team-sticker > strong {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-size: 1.8rem;
    font-variant-numeric: tabular-nums;
  }

  .classroom-team-sticker small {
    font-size: 0.8125rem;
    font-weight: 850;
  }

  .privacy-sticker {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 10px 18px;
    border-color: var(--on-pastel);
    background: #e8f7cf;
    box-shadow: var(--card-shadow);
    color: var(--on-pastel);
    font-size: 1rem;
  }

  .privacy-sticker span {
    font-size: 1.25rem;
  }

  .classroom-tool {
    margin-top: 0;
  }

  .classroom-tool-heading,
  .panel-heading,
  .roster-heading,
  .setup-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .classroom-tool-heading {
    margin-bottom: 18px;
  }

  .classroom-tool-heading h2,
  .panel-heading h2 {
    margin: 0;
    font-size: clamp(26px, 4vw, 38px);
  }

  .classroom-tool-heading p,
  .setup-help {
    margin: 6px 0 0;
    color: var(--muted);
  }

  .classroom-kicker {
    display: inline-block;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .class-count-badge,
  .play-ready {
    flex: none;
    padding: 8px 12px;
    border: 2px solid var(--on-pastel);
    border-radius: 999px;
    background: #fff2b8;
    box-shadow: 2px 2px 0 var(--shadow);
    color: var(--on-pastel);
    font-size: 0.875rem;
    font-weight: 900;
  }

  .class-picker {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 205px), 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }

  .class-picker :global(.class-card),
  .class-picker :global(.new-class-card) {
    display: flex;
    min-height: 128px;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border: var(--card-border) solid var(--ink);
    border-radius: var(--r);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    color: var(--ink);
    text-align: left;
    transition:
      transform 0.08s,
      box-shadow 0.08s,
      background-color 0.15s;
  }

  .class-picker :global(.class-card:hover),
  .class-picker :global(.new-class-card:hover) {
    box-shadow: var(--card-shadow-raised);
  }

  @media (prefers-reduced-motion: no-preference) {
    .class-picker :global(.class-card:hover),
    .class-picker :global(.new-class-card:hover) {
      transform: translate(-1px, -1px);
    }

    .class-picker :global(.class-card:active),
    .class-picker :global(.new-class-card:active) {
      transform: translate(3px, 3px);
    }
  }

  .class-picker :global(.class-card:active),
  .class-picker :global(.new-class-card:active) {
    box-shadow: 0 0 0 var(--shadow);
  }

  .class-picker :global(.class-card[aria-pressed="true"]) {
    border-color: var(--on-pastel);
    background: #fff1b3;
    color: var(--on-pastel);
    outline: 3px solid var(--on-pastel);
    outline-offset: 2px;
  }

  .class-picker :global(.class-card[aria-pressed="true"] .class-card-copy small) {
    color: var(--on-pastel);
  }

  .class-picker :global(.class-card-face) {
    display: grid;
    width: 56px;
    height: 56px;
    flex: none;
    place-items: center;
    border: 2px solid var(--on-pastel);
    border-radius: 16px;
    background: #fff;
    font-size: 1.9rem;
  }

  .class-picker :global(.class-card-copy) {
    display: grid;
    min-width: 0;
    gap: 4px;
  }

  .class-picker :global(.class-card-copy strong) {
    overflow-wrap: anywhere;
    font-size: 1.1rem;
    line-height: 1.1;
  }

  .class-picker :global(.class-card-copy small) {
    color: var(--muted);
    font-weight: 700;
  }

  .class-picker :global(.new-class-card) {
    justify-content: center;
    border-style: dashed;
    border-color: var(--on-pastel);
    background: #fff9e8;
    color: var(--on-pastel);
    font-size: 1.2rem;
    font-weight: 900;
    text-align: center;
  }

  .class-picker :global(.new-class-card span) {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 2px solid var(--on-accent);
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 1.7rem;
  }

  .class-picker :global(.empty-classes) {
    display: grid;
    grid-column: 1 / -1;
    margin: 0;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 22px;
    padding: 22px 24px;
    border: 2.5px solid var(--on-pastel);
    border-radius: 22px;
    background: linear-gradient(115deg, #fff5ce, #fffdf6 56%);
    box-shadow: 5px 5px 0 var(--shadow);
    color: var(--on-pastel);
  }

  .class-picker :global(.empty-class-face) {
    display: grid;
    width: 76px;
    height: 76px;
    place-items: center;
    border: var(--card-border) solid var(--on-pastel);
    border-radius: var(--r);
    background: #fff;
    box-shadow: var(--card-shadow);
    font-size: 3rem;
  }

  .class-picker :global(.empty-class-copy) {
    min-width: 0;
  }

  .class-picker :global(.empty-class-copy h3) {
    margin: 0;
    font-size: clamp(23px, 3vw, 32px);
  }

  .class-picker :global(.empty-class-steps) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .class-picker :global(.empty-class-steps li) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.92rem;
    font-weight: 800;
  }

  .class-picker :global(.empty-class-steps b) {
    display: grid;
    width: 27px;
    height: 27px;
    flex: none;
    place-items: center;
    border: 1.5px solid var(--on-pastel);
    border-radius: 50%;
    background: #ffdb66;
    color: var(--on-pastel);
    font-size: 0.875rem;
  }

  .class-picker :global(.empty-classes .new-class-card) {
    min-height: 58px;
    justify-content: center;
    border-style: solid;
    border-color: var(--on-accent);
    background: var(--accent);
    box-shadow: var(--card-shadow);
    color: var(--on-accent);
    font-size: 1.05rem;
    font-weight: 900;
  }

  .class-picker :global(.empty-classes .new-class-card:hover) {
    box-shadow: var(--card-shadow-raised);
  }

  .class-picker :global(.empty-classes .new-class-card span) {
    border-color: var(--on-accent);
    background: transparent;
  }

  .classroom-toast {
    min-height: 0;
    margin: 0;
    color: var(--on-pastel);
    font-weight: 800;
  }

  .classroom-toast:not(:empty) {
    margin: 0 0 14px;
    padding: 12px 16px;
