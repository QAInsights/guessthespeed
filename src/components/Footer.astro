---
import { Icon } from 'astro-icon/components';
import { LOCALES, LOCALE_INFO, type Locale } from '../lib/i18n';
import * as m from '../paraglide/messages.js';

interface Props {
  locale: Locale;
  localized: boolean;
}

const { locale, localized } = Astro.props;
---

<footer>
  <div class="wrap foot">
    <div class="foot-copy">
      <p>{m.footer_description({}, { locale })}</p>
      <p>{m.footer_made_by({}, { locale })}</p>
      <p>{m.footer_copyright({}, { locale })}</p>
    </div>
    <div class="foot-groups">
      <nav class="foot-group" aria-label={m.footer_more_projects({}, { locale })}>
        <h2>{m.footer_more_projects({}, { locale })}</h2>
        <div class="foot-links">
          <a href="https://qainsights.com" rel="noopener">QAInsights</a>
          <a href="https://dosa.dev" rel="noopener">dosa.dev</a>
          <a href="https://ai.dosa.dev" rel="noopener">ai.dosa.dev</a>
          <a href="https://iamspeed.dev" rel="noopener">iamspeed.dev</a>
          <a href="https://buymeacoffee.com/qainsights" target="_blank" rel="noopener">
            <Icon name="ph:coffee-fill" aria-hidden="true" />
            {m.footer_buy_coffee({}, { locale })}
          </a>
          <a href="https://github.com/QAInsights/guessthespeed" target="_blank" rel="noopener">
            <Icon name="ph:github-logo-fill" aria-hidden="true" />
            GitHub
          </a>
        </div>
      </nav>
      <nav class="foot-group" aria-label={m.footer_guide({}, { locale })}>
        <h2>{m.footer_guide({}, { locale })}</h2>
        <div class="foot-links">
          <a href="/story/">{m.footer_our_story({}, { locale })}</a>
          <a href="/how-to-play/">{m.footer_how_to_play({}, { locale })}</a>
          <a href="/how-it-works/">{m.footer_how_it_works({}, { locale })}</a>
          <a href="/internet-speed-101/">{m.footer_internet_speed_101({}, { locale })}</a>
          <a href="/what-is-a-good-internet-speed/">{m.footer_good_speed({}, { locale })}</a>
          <a href="/how-much-internet-speed-do-i-need/">{m.footer_speed_calculator({}, { locale })}</a>
          <a href="/mbps-to-mbs/">{m.footer_mbps_converter({}, { locale })}</a>
          <a href="/privacy/">{m.footer_privacy({}, { locale })}</a>
        </div>
      </nav>
      <nav class="foot-group" aria-label={m.footer_play_ideas({}, { locale })}>
        <h2>{m.footer_play_ideas({}, { locale })}</h2>
        <div class="foot-links">
          <a href="/speed-test-game/">{m.footer_speed_test_game({}, { locale })}</a>
          <a href="/family-game-night-ideas/">{m.footer_game_night_ideas({}, { locale })}</a>
          <a href="/internet-speed-lesson-for-kids/">{m.footer_classroom_lesson({}, { locale })}</a>
        </div>
      </nav>
      <nav class="foot-group" aria-label={m.footer_languages({}, { locale })}>
        <h2>{m.footer_languages({}, { locale })}</h2>
        <div class="foot-links">
          {LOCALES.map((code) => (
            <a
              href={code === 'en' ? '/' : `/${code}/`}
              lang={code}
              hreflang={code}
              aria-current={localized && code === locale ? 'page' : undefined}
            >
              {LOCALE_INFO[code].native}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</footer>
