---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import {
  LOCALES,
  LOCALE_INFO,
  formatNumber,
  localeHome,
  type Locale,
} from '../lib/i18n';
import { themeHintMessages, themeLabelMessages } from '../lib/ui-messages';
import { type ThemeId } from '../lib/themes';
import * as m from '../paraglide/messages.js';

interface Props {
  title?: string;
  description?: string;
  breadcrumb?: string;
  schema?: Record<string, unknown>[];
  locale?: Locale;
  localized?: boolean;
}

const {
  locale = 'en',
  title = m.home_title({}, { locale: 'en' }),
  description = m.home_description({}, { locale: 'en' }),
  breadcrumb,
  schema = [],
  localized = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://guessthespeed.com').toString();
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const themeHints: Record<ThemeId, { emoji: string; hint: string }> = {
  light: { emoji: '☀️', hint: themeHintMessages.light() },
  dark: { emoji: '🌙', hint: themeHintMessages.dark() },
  halloween: { emoji: '🎃', hint: themeHintMessages.halloween() },
  diwali: { emoji: '🪔', hint: themeHintMessages.diwali() },
  thanksgiving: { emoji: '🥧', hint: themeHintMessages.thanksgiving() },
  winter: { emoji: '❄️', hint: themeHintMessages.winter() },
  christmas: { emoji: '🎄', hint: themeHintMessages.christmas() },
  newyear: { emoji: '🎉', hint: themeHintMessages.newyear() },
  pongal: { emoji: '🌾', hint: themeHintMessages.pongal() },
  valentines: { emoji: '💌', hint: themeHintMessages.valentines() },
  holi: { emoji: '🎨', hint: themeHintMessages.holi() },
  easter: { emoji: '🐣', hint: themeHintMessages.easter() },
};
const themeChoices = (Object.keys(themeHints) as ThemeId[]).map((id) => ({
  id,
  label: themeLabelMessages[id](),
  ...themeHints[id],
}));
const websiteId = 'https://guessthespeed.com/#website';
const authorId = 'https://guessthespeed.com/#author';
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: 'Guess the Speed',
    url: 'https://guessthespeed.com/',
    inLanguage: localized ? [...LOCALES] : 'en',
    publisher: { '@id': authorId },
  },
  {
    '@type': 'Person',
    '@id': authorId,
    name: 'NaveenKumar Namachivayam',
    url: 'https://qainsights.com',
    sameAs: [
      'https://qainsights.com',
      'https://github.com/QAInsights',
      'https://dosa.dev',
      'https://iamspeed.dev',
    ],
  },
];
if (breadcrumb && Astro.url.pathname !== '/') {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
      item: 'https://guessthespeed.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: breadcrumb,
        item: canonical,
      },
    ],
  });
}
graph.push(...schema);
const graphSchema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html
  lang={locale}
  data-theme="light"
  data-home={localized ? '1' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const roomQueryMode = new URLSearchParams(window.location.search).has("room");
      if (roomQueryMode) document.documentElement.dataset.room = "1";
      const devParam = new URLSearchParams(window.location.search).get("dev");
      let devEnabled = devParam === "1";
      try {
        if (!roomQueryMode && (devParam === "1" || devParam === "0"))
          localStorage.setItem("gts:dev", devParam);
        if (!roomQueryMode && devParam === null)
          devEnabled = localStorage.getItem("gts:dev") === "1";
      } catch {}
      if (!roomQueryMode && devEnabled)
        document.documentElement.dataset.dev = "1";
      const tvParam = new URLSearchParams(window.location.search).get("tv");
      let tvEnabled = tvParam === "1";
      try {
        if (tvParam === "1" || tvParam === "0")
          localStorage.setItem("gts:tv", tvParam);
        else tvEnabled = localStorage.getItem("gts:tv") === "1";
      } catch {}
      document.documentElement.dataset.tv = tvEnabled ? "1" : "0";
      try {
        if (window.location.pathname === "/") {
          const savedLocale = localStorage.getItem("gts:locale");
          if (savedLocale && savedLocale !== "en" && ["ta", "hi", "es", "pt", "fr", "de"].includes(savedLocale))
            window.location.replace("/" + savedLocale + "/" + window.location.search + window.location.hash);
        }
      } catch {}
    </script>
    <script is:inline>
      try {
        const roomPage = document.documentElement.dataset.room === "1";
        const savedSettings = JSON.parse(
          localStorage.getItem(
            roomPage ? "gts:room-settings" : "gts:v1",
          ) ?? "null",
        );
        const themeMode = roomPage
          ? savedSettings?.themeMode
          : savedSettings?.settings?.themeMode;
        const explicitThemes = [
          "light",
          "dark",
          "halloween",
          "diwali",
          "thanksgiving",
          "winter",
          "christmas",
          "newyear",
          "pongal",
          "valentines",
          "holi",
          "easter",
        ];
        if (explicitThemes.includes(themeMode))
          document.documentElement.dataset.theme = themeMode;
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eceff3" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Guess the Speed" />
    <meta property="og:locale" content={LOCALE_INFO[locale].og} />
    {localized && LOCALES.filter((code) => code !== locale).map((code) => (
      <meta property="og:locale:alternate" content={LOCALE_INFO[code].og} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://guessthespeed.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://guessthespeed.com/og.png" />
    {localized && LOCALES.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={`https://guessthespeed.com${localeHome(code)}`}
      />
    ))}
    {localized && (
      <link rel="alternate" hreflang="x-default" href="https://guessthespeed.com/" />
    )}
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)}></script>
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="fx-layer" data-fx-layer aria-hidden="true"></div>
    <header class="wrap top">
      <a class="logo" href={localized ? localeHome(locale) : '/'} aria-label={m.header_logo_aria({}, { locale })}>
        <span class="logo-badge">?</span>
        <b>guess the speed</b>
      </a>
      <div class="ctrls">
        <div class="theme-picker" data-theme-picker>
          <button class="ctrl theme-trigger" type="button" data-theme-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-menu" aria-label={m.header_theme_aria({}, { locale })}>
            <span class="theme-dot" aria-hidden="true"></span>
            <span class="theme-trigger-label" data-theme-label>{m.header_theme_auto({}, { locale })}</span>
            <Icon name="ph:caret-down-bold" class="theme-caret" aria-hidden="true" />
          </button>
          <div class="theme-menu" id="theme-menu" data-theme-menu hidden>
            <p class="theme-menu-title" id="theme-menu-title">{m.header_theme_menu_title({}, { locale })}</p>
            <div class="theme-grid" role="listbox" aria-labelledby="theme-menu-title" data-theme-list>
              <button class="theme-option" type="button" role="option" aria-selected="false" tabindex="-1" data-theme-option="auto" data-theme="light">
                <span class="theme-swatch" aria-hidden="true">📅</span>
                <span class="theme-option-text"><b>{m.header_theme_auto({}, { locale })}</b><small data-theme-auto-hint>{m.header_theme_auto_hint({}, { locale })}</small></span>
              </button>
              {themeChoices.map(({ id, label, emoji, hint }) => (
                <button class="theme-option" type="button" role="option" aria-selected="false" tabindex="-1" data-theme-option={id} data-theme={id}>
                  <span class="theme-swatch" aria-hidden="true">{emoji}</span>
                  <span class="theme-option-text"><b>{label}</b><small>{hint}</small></span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <button class="ctrl icon-btn" type="button" data-sound-toggle aria-label={m.settings_sound({}, { locale })} aria-pressed="true">
          <span data-sound-on><Icon name="ph:speaker-high-fill" /></span>
          <span data-sound-off hidden><Icon name="ph:speaker-slash-fill" /></span>
        </button>
        <button class="ctrl icon-btn" type="button" data-tv-toggle aria-label={m.header_tv_aria({}, { locale })} title={m.header_tv_title({}, { locale })} aria-pressed="false">
          <Icon name="ph:television-simple-bold" />
        </button>
        <button class="ctrl icon-btn" type="button" data-fullscreen aria-label={m.header_fullscreen_aria({}, { locale })} title={m.header_fullscreen_aria({}, { locale })} aria-pressed="false" hidden>
          <Icon name="ph:corners-out-bold" />
        </button>
        <a class="ctrl icon-btn how-link" href="/how-to-play/" aria-label={m.header_how_to_play_aria({}, { locale })}>
          <Icon name="ph:question-fill" />
        </a>
        <button class="dev-badge" type="button" data-dev-badge hidden aria-label={m.header_dev_mode_aria({}, { locale })}>DEV</button>
        <div class="language-picker" data-language-picker>
          <button class="ctrl language-trigger" type="button" data-language-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="language-menu" aria-label={m.header_language_aria({ language: LOCALE_INFO[locale].native }, { locale })}>
            <Icon name="ph:globe-simple-bold" aria-hidden="true" />
            <span data-current-language>{locale.toUpperCase()}</span>
          </button>
          <div class="language-menu" id="language-menu" data-language-menu hidden>
            <p class="language-menu-title" id="language-menu-title">{m.header_language_menu_title({}, { locale })}</p>
            <div role="listbox" aria-labelledby="language-menu-title" data-language-list>
              {LOCALES.map((code) => (
                <button class="language-option" type="button" role="option" aria-selected={code === locale} tabindex="-1" data-language-option={code}>
                  <b>{LOCALE_INFO[code].native}</b><small>{LOCALE_INFO[code].english}</small>
                </button>
              ))}
            </div>
          </div>
        </div>
        <button class="ctrl icon-btn" type="button" data-open-settings aria-label={m.header_settings_aria({}, { locale })}>
          <Icon name="ph:gear-six-fill" />
        </button>
      </div>
    </header>
    <dialog class="sticker-dialog" data-settings-dialog aria-labelledby="settings-title">
      <div class="dialog-inner">
        <div class="dialog-head">
          <h2 id="settings-title" class="display">{m.settings_title({}, { locale })}</h2>
          <button class="dialog-close" type="button" data-close-settings aria-label={m.settings_close_aria({}, { locale })}><Icon name="ph:x-bold" /></button>
        </div>
        <form class="dialog-form" data-settings-form>
          <label class="dialog-field">{m.settings_rounds({}, { locale })}
            <select class="dialog-select" name="rounds">
              <option value="1">{m.settings_round_option({ count: 1, formatted: formatNumber(1, locale) }, { locale })}</option>
              <option value="3">{m.settings_round_option({ count: 3, formatted: formatNumber(3, locale) }, { locale })}</option>
              <option value="5">{m.settings_round_option({ count: 5, formatted: formatNumber(5, locale) }, { locale })}</option>
              <option value="7">{m.settings_round_option({ count: 7, formatted: formatNumber(7, locale) }, { locale })}</option>
              <option value="10">{m.settings_round_option({ count: 10, formatted: formatNumber(10, locale) }, { locale })}</option>
              <option value="endless">{m.settings_endless({}, { locale })}</option>
            </select>
          </label>
          <label class="dialog-field">{m.settings_ties({}, { locale })}
            <select class="dialog-select" name="tieMode">
              <option value="share">{m.settings_share_points({}, { locale })}</option>
              <option value="download">{m.settings_download_tiebreak({}, { locale })}</option>
            </select>
          </label>
          <label class="dialog-field">{m.settings_theme({}, { locale })}
            <select class="dialog-select" name="themeMode">
              <option value="auto">{m.header_theme_auto({}, { locale })}</option>
              <option value="light">{m.theme_light({}, { locale })}</option>
              <option value="dark">{m.theme_dark({}, { locale })}</option>
              <option value="halloween">{m.theme_halloween({}, { locale })}</option>
              <option value="diwali">{m.theme_diwali({}, { locale })}</option>
              <option value="thanksgiving">{m.theme_thanksgiving({}, { locale })}</option>
              <option value="winter">{m.theme_winter({}, { locale })}</option>
              <option value="christmas">{m.theme_christmas({}, { locale })}</option>
              <option value="newyear">{m.theme_newyear({}, { locale })}</option>
              <option value="pongal">{m.theme_pongal({}, { locale })}</option>
              <option value="valentines">{m.theme_valentines({}, { locale })}</option>
              <option value="holi">{m.theme_holi({}, { locale })}</option>
              <option value="easter">{m.theme_easter({}, { locale })}</option>
            </select>
          </label>
          <label class="dialog-field sound-setting"><span>{m.settings_sound({}, { locale })}</span><input type="checkbox" name="sound" /></label>
          <label class="dialog-field tv-setting">
            <span>{m.settings_tv_mode({}, { locale })}<small>{m.settings_tv_mode_help({}, { locale })}</small></span>
            <input type="checkbox" name="tvMode" />
          </label>
          <label class="dialog-field dev-setting">
            <span>{m.settings_developer_mode({}, { locale })}<small>{m.settings_developer_mode_help({}, { locale })}</small></span>
            <input type="checkbox" name="devMode" />
          </label>
          <p class="room-settings-note" data-room-settings-note hidden>{m.settings_room_host_note({}, { locale })}</p>
          <div class="dialog-actions">
            <button class="go" type="submit">{m.settings_save({}, { locale })}</button>
          </div>
        </form>
      </div>
    </dialog>
    <slot />
    <Footer locale={locale} localized={localized} />
    <script>
      import '../scripts/header-client';
    </script>
  </body>
</html>
