---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import bricolageFontUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import figtreeFontUrl from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import HousePromo from '../components/HousePromo.astro';
import ModeSwitch from '../components/ModeSwitch.astro';
import { ogCardFor, ogImagePath } from '../lib/og-cards';
import { themes, type ThemeId } from '../lib/themes';

interface Props {
  title?: string;
  description?: string;
  breadcrumb?: string;
  schema?: Record<string, unknown>[];
  modeSwitch?: "game" | "classroom" | "work";
  noindex?: boolean;
}

const {
  title = 'Guess the Speed | The Internet Speed Guessing Game for Families',
  description = "A free family game: everyone guesses the Wi-Fi download and upload speed, then a real speed test reveals who came closest. Play on one screen or on everyone's phone.",
  breadcrumb,
  schema = [],
  modeSwitch,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://guessthespeed.com').toString();
const ogCard = ogCardFor(Astro.url.pathname);
const ogImageAlt = `${ogCard.line1} ${ogCard.line2}`;
const ogImageUrl = `https://guessthespeed.com${ogImagePath(Astro.url.pathname)}`;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const themeHints: Record<ThemeId, { emoji: string; hint: string }> = {
  light: { emoji: '☀️', hint: 'Bright and bold' },
  dark: { emoji: '🌙', hint: 'Night mode' },
  halloween: { emoji: '🎃', hint: 'Oct 15 to 31' },
  diwali: { emoji: '🪔', hint: 'Around Diwali' },
  thanksgiving: { emoji: '🥧', hint: 'Late November' },
  winter: { emoji: '❄️', hint: 'January' },
  christmas: { emoji: '🎄', hint: 'Dec 1 to 26' },
  newyear: { emoji: '🎉', hint: 'Dec 27 to Jan 2' },
  pongal: { emoji: '🌾', hint: 'Jan 13 to 17' },
  valentines: { emoji: '💌', hint: 'Feb 7 to 14' },
  holi: { emoji: '🎨', hint: 'Around Holi' },
  easter: { emoji: '🐣', hint: 'Easter week' },
  eidfitr: { emoji: '🌙', hint: 'Around Eid al-Fitr' },
  eidadha: { emoji: '🕌', hint: 'Around Eid al-Adha' },
  lunarnewyear: { emoji: '🏮', hint: 'Around Lunar New Year' },
  stpatricks: { emoji: '☘️', hint: 'Mar 15 to 17' },
};
const themeChoices = (Object.keys(themeHints) as ThemeId[]).map((id) => ({
  id,
  label: themes[id].label,
  ...themeHints[id],
}));
const websiteId = 'https://guessthespeed.com/#website';
const authorId = 'https://guessthespeed.com/#author';
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    name: 'Guess the Speed',
    url: 'https://guessthespeed.com/',
    inLanguage: 'en',
    publisher: { '@id': authorId },
  },
  {
    '@type': 'Person',
    '@id': authorId,
    name: 'NaveenKumar Namachivayam',
    url: 'https://qainsights.com',
    sameAs: [
      'https://qainsights.com',
      'https://github.com/QAInsights',
      'https://dosa.dev',
      'https://iamspeed.dev',
    ],
  },
];
if (breadcrumb && Astro.url.pathname !== '/') {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://guessthespeed.com/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: breadcrumb,
        item: canonical,
      },
    ],
  });
}
graph.push(...schema);
const graphSchema = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html
  lang="en"
  data-theme="light"
  data-home={Astro.url.pathname === '/' ? '1' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <link
      rel="preload"
      href={bricolageFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={figtreeFontUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      const roomQueryRequested = new URLSearchParams(window.location.search).has("room");
      let classroomSessionActive = false;
      try {
        const session = JSON.parse(
          localStorage.getItem("gts:classroom-session") ?? "null",
        );
        classroomSessionActive =
          !!session &&
          typeof session.classId === "string" &&
          !!session.classId &&
          typeof session.className === "string" &&
          !!session.className.trim() &&
          (session.mode === "teams" || session.mode === "spotlight") &&
          typeof session.startedAt === "number" &&
          Number.isFinite(session.startedAt) &&
          session.startedAt >= 0;
      } catch {}
      const roomQueryMode = roomQueryRequested && !classroomSessionActive;
      const leavesDevMode =
        /^\/(?:classroom|work)\/?$/.test(window.location.pathname);
      if (roomQueryMode) document.documentElement.dataset.room = "1";
      const devParam = new URLSearchParams(window.location.search).get("dev");
      let devEnabled = devParam === "1";
      try {
        if (leavesDevMode) localStorage.setItem("gts:dev", "0");
        else if (
          !roomQueryMode &&
          !classroomSessionActive &&
          (devParam === "1" || devParam === "0")
        )
          localStorage.setItem("gts:dev", devParam);
        if (
          !leavesDevMode &&
          !roomQueryMode &&
          !classroomSessionActive &&
          devParam === null
        )
          devEnabled = localStorage.getItem("gts:dev") === "1";
      } catch {}
      if (
        !leavesDevMode &&
        !roomQueryMode &&
        !classroomSessionActive &&
        devEnabled
      )
        document.documentElement.dataset.dev = "1";
      const tvParam = new URLSearchParams(window.location.search).get("tv");
      let tvEnabled = tvParam === "1";
      try {
        if (tvParam === "1" || tvParam === "0")
          localStorage.setItem("gts:tv", tvParam);
        else tvEnabled = localStorage.getItem("gts:tv") === "1";
      } catch {}
      document.documentElement.dataset.tv = tvEnabled ? "1" : "0";
    </script>
    <script is:inline>
      try {
        const roomPage = document.documentElement.dataset.room === "1";
        const savedSettings = JSON.parse(
          localStorage.getItem(
            roomPage ? "gts:room-settings" : "gts:v1",
          ) ?? "null",
        );
        const themeMode = roomPage
          ? savedSettings?.themeMode
          : savedSettings?.settings?.themeMode;
        const explicitThemes = [
          "light",
          "dark",
          "halloween",
          "diwali",
          "thanksgiving",
          "winter",
          "christmas",
          "newyear",
          "pongal",
          "valentines",
          "holi",
          "easter",
          "eidfitr",
          "eidadha",
          "lunarnewyear",
          "stpatricks",
        ];
        if (explicitThemes.includes(themeMode)) {
          document.documentElement.dataset.theme = themeMode;
        } else {
          const today = new Date();
          const localDay = `${today.getFullYear()}-${String(
            today.getMonth() + 1,
          ).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          let resolvedTheme = null;
          try {
            resolvedTheme = JSON.parse(
              localStorage.getItem("gts:theme-resolved") ?? "null",
            );
          } catch {}
          if (
            resolvedTheme?.mode === "auto" &&
            resolvedTheme?.day === localDay &&
            resolvedTheme?.dark === prefersDark &&
            explicitThemes.includes(resolvedTheme?.theme)
          ) {
            document.documentElement.dataset.theme = resolvedTheme.theme;
          } else if (prefersDark) {
            document.documentElement.dataset.theme = "dark";
          }
        }
        const animatedBorders = roomPage
          ? savedSettings?.animatedBorders
          : savedSettings?.settings?.animatedBorders;
        if (animatedBorders === false)
          document.documentElement.dataset.aurora = "0";
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eceff3" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Guess the Speed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)}></script>
    {beaconToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <div class="fx-layer" data-fx-layer aria-hidden="true"></div>
    <header class="wrap top">
      <a class="logo" href="/" aria-label="Guess the Speed home">
        <span class="logo-badge">?</span>
        <b>guess the speed</b>
      </a>
      <div class="ctrls">
        <div class="theme-picker" data-theme-picker>
          <button class="ctrl theme-trigger" type="button" data-theme-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="theme-menu">
            <span class="theme-dot" aria-hidden="true"></span>
            <span class="theme-trigger-label" data-theme-label>Auto (by date)</span>
            <span class="sr">, change theme</span>
            <Icon name="ph:caret-down-bold" class="theme-caret" aria-hidden="true" />
          </button>
          <div class="theme-menu" id="theme-menu" data-theme-menu hidden>
            <p class="theme-menu-title" id="theme-menu-title">Pick a theme</p>
            <div class="theme-grid" role="listbox" aria-labelledby="theme-menu-title" data-theme-list>
              <button class="theme-option" type="button" role="option" aria-selected="false" tabindex="-1" data-theme-option="auto" data-theme="light">
                <span class="theme-swatch" aria-hidden="true">📅</span>
                <span class="theme-option-text"><b>Auto (by date)</b><small data-theme-auto-hint>Follows the calendar</small></span>
              </button>
              {themeChoices.map(({ id, label, emoji, hint }) => (
                <button class="theme-option" type="button" role="option" aria-selected="false" tabindex="-1" data-theme-option={id} data-theme={id}>
                  <span class="theme-swatch" aria-hidden="true">{emoji}</span>
                  <span class="theme-option-text"><b>{label}</b><small>{hint}</small></span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <button class="ctrl icon-btn" type="button" data-sound-toggle aria-label="Toggle sound" aria-pressed="true">
          <span data-sound-on><Icon name="ph:speaker-high-fill" /></span>
          <span data-sound-off hidden><Icon name="ph:speaker-slash-fill" /></span>
        </button>
        <button class="ctrl icon-btn" type="button" data-tv-toggle aria-label="TV mode" title="TV mode: big screen layout" aria-pressed="false">
          <Icon name="ph:television-simple-bold" />
        </button>
        <button class="ctrl icon-btn" type="button" data-fullscreen aria-label="Full screen" title="Full screen" aria-pressed="false" hidden>
          <Icon name="ph:corners-out-bold" />
        </button>
        <a class="ctrl icon-btn how-link" href="/how-to-play/" aria-label="How to play">
          <Icon name="ph:question-fill" />
        </a>
        <button class="ctrl icon-btn" type="button" data-open-settings aria-label="Open settings">
          <Icon name="ph:gear-six-fill" />
        </button>
      </div>
    </header>
    {modeSwitch && (
      <div class="wrap mode-bar">
        <ModeSwitch current={modeSwitch} />
      </div>
    )}
    <dialog class="sticker-dialog" data-settings-dialog aria-labelledby="settings-title">
      <div class="dialog-inner">
        <div class="dialog-head">
          <h2 id="settings-title" class="display">Game settings</h2>
          <button class="dialog-close" type="button" data-close-settings aria-label="Close settings"><Icon name="ph:x-bold" /></button>
        </div>
        <form class="dialog-form" data-settings-form>
          <label class="dialog-field">Rounds
            <select class="dialog-select" name="rounds">
              <option value="1">1 round</option>
              <option value="3">3 rounds</option>
              <option value="5">5 rounds</option>
              <option value="7">7 rounds</option>
              <option value="10">10 rounds</option>
              <option value="endless">Endless</option>
            </select>
          </label>
          <label class="dialog-field">Ties
            <select class="dialog-select" name="tieMode">
              <option value="share">Share the points</option>
              <option value="download">Closest download breaks the tie</option>
            </select>
          </label>
          <label class="dialog-field">Theme
            <select class="dialog-select" name="themeMode">
              <option value="auto">Auto (by date)</option>
              <option value="light">Light</option>
              <option value="dark">Dark</option>
              <option value="halloween">Halloween</option>
              <option value="diwali">Diwali</option>
              <option value="thanksgiving">Thanksgiving</option>
              <option value="winter">Winter</option>
              <option value="christmas">Christmas</option>
              <option value="newyear">New Year</option>
              <option value="pongal">Pongal</option>
              <option value="valentines">Valentine’s Day</option>
              <option value="holi">Holi</option>
              <option value="easter">Easter</option>
              <option value="eidfitr">Eid al-Fitr</option>
              <option value="eidadha">Eid al-Adha</option>
              <option value="lunarnewyear">Lunar New Year</option>
              <option value="stpatricks">St. Patrick’s Day</option>
            </select>
          </label>
          <label class="dialog-field sound-setting"><span>Sound</span><input type="checkbox" name="sound" /></label>
          <label class="dialog-field confetti-setting"><span>Confetti<small>A quick burst when the champion is crowned.</small></span><input type="checkbox" name="confetti" /></label>
          <label class="dialog-field aurora-setting"><span>Animated borders<small>Soft moving light around each player card.</small></span><input type="checkbox" name="animatedBorders" /></label>
          <fieldset class="dialog-plan-group">
            <legend>Your internet plan</legend>
            <label class="dialog-field" for="planDown">Plan download (Mbps)
              <input class="dialog-input" id="planDown" name="planDown" type="number" min="1" max="10000" step="any" inputmode="decimal" placeholder="500" />
            </label>
            <label class="dialog-field" for="planUp">Plan upload (Mbps)
              <input class="dialog-input" id="planUp" name="planUp" type="number" min="1" max="10000" step="any" inputmode="decimal" placeholder="50" />
            </label>
            <p class="dialog-plan-hint">Optional. Saved on this device only, never sent anywhere.</p>
          </fieldset>
          <p class="room-settings-note" data-room-settings-note hidden>Only the host can change rounds or tie rules in this room.</p>
          <div class="dialog-actions">
            <button class="go" type="submit">Save settings</button>
          </div>
        </form>
      </div>
    </dialog>
    <slot />
    <Footer />
    <HousePromo />
    <script>
      import '../scripts/header-client';
    </script>
  </body>
</html>
