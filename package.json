{
  "name": "guessthespeed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:worker": "npm run build && wrangler dev",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build": "npm run i18n && astro build",
    "preview": "astro preview",
    "check": "npm run i18n && astro check && tsc -p worker",
    "test": "npm run i18n && vitest run",
    "check:i18n": "node scripts/check-i18n-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@cloudflare/speedtest": "^1.14.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@inlang/paraglide-js": "^2.25.4",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
